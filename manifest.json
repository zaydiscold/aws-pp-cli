{
  "manifest_version": "0.3",
  "name": "aws-pp-pp-mcp",
  "display_name": "Aws Pp",
  "version": "4.5.1",
  "description": "Aws Pp API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/aws-pp-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/aws-pp-pp-mcp",
      "args": [],
      "env": {
        "SERVICE_QUOTAS_HMAC": "${user_config.service_quotas_hmac}"
      }
    }
  },
  "user_config": {
    "service_quotas_hmac": {
      "type": "string",
      "title": "SERVICE_QUOTAS_HMAC",
      "description": "Sets SERVICE_QUOTAS_HMAC for the Aws Pp MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
